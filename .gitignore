# Visual Studio cache/options directory
.vs/

# JetBrains cache/options directory
.idea/

# User-specific files
*.user
query

# Build outputs and intermediate objects
**/bin/
**/obj/

# macOS exclusion files.
*.DS_Store

# SSL certificates and keys
*.pem
*.pfx
keys/

# Docker secrets (actual values — use .example.txt templates instead)
secrets/*.txt
deploy/secrets/*.txt

# Rider / JetBrains cache files and solution user settings
**/*.lscache
**/*.sln.DotSettings.user

# Project/user files
**/*.csproj.lscache
# Node.js dependencies (installed via npm, not committed)
node_modules/
PromiseModelOnline.Client/wwwroot/dist/

# Browser downloads (puppeteer/playwright cache — never commit)
chrome/
puppeteer/
*.zip
*.7z

.opencode/
.codegraph/
coverage/
.lighthouseci/

# Docker Compose local overrides (machine-specific, not committed)
docker-compose.override.yml
*.override.yml