@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Password Reset";
}

<div class="form-div auth-card">
    <div class="auth-card-icon" aria-hidden="true">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
    </div>

    <h2 class="auth-card-heading">Password Reset Successful</h2>
    <p class="auth-card-subtitle">Your password has been changed.</p>

    <p class="auth-link">
        <a href="/account/login">Sign in with your new password</a>
    </p>
</div>
