@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="form-div auth-card">
    <div class="auth-card-icon" aria-hidden="true">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
    </div>

    <h2 class="auth-card-heading">Forgot Password</h2>
    <p class="auth-card-subtitle">Enter your email to receive a reset link</p>
    <p class="auth-card-note">If you normally sign in with Google, this will add a password to your account.</p>

    @if (ViewBag.Sent ?? false)
    {
        <div class="auth-message auth-success" role="alert">
            If that email address is registered, a password reset link has been sent. Please check your inbox.
        </div>
        <p class="auth-link">
            <a href="/account/login">Return to sign in</a>
        </p>
    }
    else
    {
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-message auth-error" role="alert">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div class="field-group">
                <label asp-for="Email" class="field-label">Email</label>
                <input asp-for="Email" type="email" class="field-input" placeholder="Enter your email address" autocomplete="email" required aria-required="true" />
            </div>
            <button type="submit" class="submit-btn"><span class="btn-text">Send Reset Link</span><span class="spinner" aria-hidden="true"></span></button>
        </form>

        <p class="auth-link">
            <a href="/account/login">Back to sign in</a>
        </p>
    }
</div>
