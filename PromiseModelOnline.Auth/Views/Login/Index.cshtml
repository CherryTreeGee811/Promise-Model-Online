@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sign in";
}

<h1 class="sr-only">Sign in to Promise Model Online</h1>

<div class="form-div auth-card">
    <div class="auth-card-icon" aria-hidden="true">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4" />
            <path d="M20 21a8 8 0 10-16 0" />
        </svg>
    </div>

    <h2 class="auth-card-heading">Welcome back</h2>
    <p class="auth-card-subtitle">Sign in to your account</p>

    @if (ViewBag.Registered)
    {
        <p class="auth-message auth-success" role="status">Account created successfully. Please sign in.</p>
    }
    @if (ViewBag.Verified)
    {
        <p class="auth-message auth-success" role="status">Email verified successfully. You can now sign in.</p>
    }
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="auth-message auth-error" role="alert">@ViewBag.Error</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-message auth-error" role="alert">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" class="auth-form">
        @Html.AntiForgeryToken()
        <div class="field-group">
            <label asp-for="Username" class="field-label">Username</label>
            <input asp-for="Username" type="text" class="field-input" placeholder="Enter your username" autocomplete="username" required aria-required="true" />
        </div>
        <div class="field-group">
            <label asp-for="Password" class="field-label">Password</label>
            <div class="password-wrapper">
                <input asp-for="Password" type="password" class="field-input password-input" placeholder="Enter your password" autocomplete="current-password" required aria-required="true" />
                <button type="button" class="password-toggle" aria-label="Show password">
                    <span class="eye-icon" aria-hidden="true"></span>
                </button>
            </div>
            <a href="/account/forgot-password" class="forgot-password-link">Forgot your password?</a>
        </div>
        <input type="hidden" asp-for="ReturnUrl" />
        <button type="submit" class="submit-btn"><span class="btn-text">Sign in</span><span class="spinner" aria-hidden="true"></span></button>
    </form>

    @if (ViewBag.HasGoogle)
    {
    <div class="external-providers">
        <div class="divider" role="separator" aria-orientation="horizontal"><span class="divider-text">or continue with</span></div>

        <form method="post" action="/account/external/challenge" class="external-provider-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="provider" value="Google" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="external-provider-btn google-btn" aria-label="Sign in with Google">
                <svg class="provider-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Sign in with Google</span>
            </button>
        </form>
    </div>
    }

    <p class="auth-link">
        Don't have an account? <a href="/account/register?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl ?? "")">Create one here</a>
    </p>
</div>
