{
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": []
      },
      "hubs-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        },
        "Transforms": []
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "https://promisemodelonline.api:8000/"
          }
        }
      }
    }
  }
}