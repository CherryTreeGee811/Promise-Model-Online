{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/projects/\\d+/export",
    "headers": {
      "Cookie": {
        "contains": "__Host-pmo.session=owner-session"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Content-Disposition": "attachment; filename=\"uber-project-export.json\"",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Headers": "Authorization, Content-Type",
      "Access-Control-Allow-Methods": "GET, POST, PATCH, PUT, DELETE, OPTIONS"
    },
    "bodyFileName": "uber-project-export.json"
  }
}
