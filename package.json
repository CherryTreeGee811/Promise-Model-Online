{
  "name": "promise-model-online",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint 'PromiseModelOnline.Client/wwwroot/js/**/*.{mjs,ts}'",
    "lint:html": "htmlhint 'PromiseModelOnline.Client/wwwroot/**/*.html'",
    "lint:css": "stylelint 'PromiseModelOnline.Client/wwwroot/css/*.css'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:dry": "jscpd",
    "lint:dead": "knip --no-progress",
    "lint:all": "npm run lint && npm run lint:html && npm run lint:css && npm run lint:dry && npm run lint:dead && npm run typecheck",
    "lint:a11y": "node a11y-check.mjs",
    "lint:leaks": "memlab run --scenario scripts/memlab-scenarios/leak-check.cjs",
    "lint:leaks:iterative": "node scripts/check-memory-leaks-iterative.cjs",
    "lint:lighthouse": "lhci autorun",
    "lint:ci": "npm run lint && npm run lint:html && npm run lint:css && npm run lint:dry && npm run lint:dead && npm run lint:nginx && npm run lint:responsive && npm run typecheck && npm run lint:a11y",
    "lint:nginx": "bash scripts/check-nginx.sh",
    "lint:responsive": "node scripts/check-responsive.mjs",
    "lint:boundary": "bash scripts/check-prod-deps.sh && bash scripts/check-source-imports.sh && bash scripts/check-bundle.sh",
    "lint:docker-deps": "bash scripts/check-docker-deps.sh",
    "pwa:check": "node pwa-check.mjs https://localhost:9000",
    "pwa:check:url": "node pwa-check.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "d3": "^7.9.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "eslint-plugin-unicorn": "^68.0.0",
    "globals": "^17.6.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.0.10",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "memlab": "^2.0.3",
    "playwright-core": "1.60.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "tmp": "0.2.7",
    "uuid": "14.0.0",
    "js-yaml": "4.2.0"
  },
  "allowScripts": {
    "memlab@2.0.3": true,
    "@memlab/cli@2.0.3": true,
    "puppeteer@24.43.1": true,
    "sleep@6.1.0": true,
    "unrs-resolver@1.12.2": true
  }
}
