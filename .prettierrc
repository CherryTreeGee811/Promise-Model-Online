{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 180,
  "tabWidth": 4,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "html"
      }
    },
    {
      "files": "*.json",
      "options": {
        "parser": "json"
      }
    }
  ]
}
