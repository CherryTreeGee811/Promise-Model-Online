ASPNETCORE_ENVIRONMENT=Production
API_DB_USER=pmo_api
AUTH_DB_USER=pmo_auth
PMO_API_DB_USER=pmo_api
PMO_AUTH_DB_USER=pmo_auth
APP_BASE_URL=https://promisemodel.online
AUTH_AUTHORITY=${APP_BASE_URL}
AUTH_INTERNAL_AUTHORITY=https://promisemodelonline.auth:8060
AUTH_PUBLIC_ISSUER=${APP_BASE_URL}
AUTH_METADATA_ADDRESS=https://promisemodelonline.auth:8060/.well-known/openid-configuration
AUTH_GOOGLE_CLIENT_ID=340495856258-u0vhgc0cufeelig1jjutcg9okon5ruok.apps.googleusercontent.com

DATA_PROTECTION_KEYS_PATH=/app/dp-keys
UMAMI_ADMIN_USERNAME=pmo_admin

# Cloudflare Tunnel (via COMPOSE_PROFILES):
#   production → named promisemodel.online tunnel (requires token in secrets/cloudflare_tunnel_token.txt)
#   unset     → no tunnel (CI/local)
COMPOSE_PROFILES=production
